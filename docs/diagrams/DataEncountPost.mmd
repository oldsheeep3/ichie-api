sequenceDiagram
  participant C as Client
  participant S as Server
  participant DB as Database

  C->>S: POST /data/encount (Authorization: Bearer) { message? }
  S->>S: validate JWT -> get user_id
  S->>DB: INSERT INTO encounters(id, user_id, message, createat)
  DB-->>S: created encounter id
  S->>DB: SELECT users WHERE id=user_id LIMIT 1
  DB-->>S: reporter's profile
  S-->>C: 201 EncountResponse { id, user_id, message?, createat, name?, icon? }
